# --- Database ---
# Local dev (docker-compose provides this Postgres):
DATABASE_URL="postgresql://rpc:rpc@localhost:5432/rpc?schema=public"

# --- Auth ---
# 32+ byte random secret used to sign session + password-reset JWTs.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"
SESSION_TTL_HOURS="168"

# --- Seed admin (never hardcoded; seed reads these) ---
ADMIN_EMAIL="admin@redplanet.example"
ADMIN_PASSWORD="change-me-strong-admin-password"

# --- Scheduler / cron ---
# Shared secret required by POST /api/cron/tick and the scheduler daemon.
CRON_SECRET="change-me-cron-secret"
# Default turn length for freshly seeded games (hours).
DEFAULT_TURN_LENGTH_HOURS="96"
# Poll interval for the standalone scheduler daemon (seconds).
SCHEDULER_POLL_SECONDS="60"
# Base URL the scheduler daemon calls (or it runs in-process if unset).
APP_BASE_URL="http://localhost:3000"
